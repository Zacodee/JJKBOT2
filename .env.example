[TEMPLATE]
[TEMPLATE]
# Token privé du bot Discord
DISCORD_TOKEN=

# Identifiant de l’application Discord
CLIENT_ID=

# Identifiant du serveur de test (les commandes y apparaissent immédiatement)
GUILD_ID=

# Palette des embeds : violet (défaut) ou noblesse
THEME=violet

# Repli de la banniere (debut ET fin de chaque reponse) : en priorite, le bot
# envoie le fichier local assets/banniere_jjk.png, qui n’expire jamais.
# Cette URL ne sert que si ce fichier est absent (URL directe, sans expiration).
BANNER_URL=

# URL directe du GIF affiché dans l’embed de /jjk help
# (héberge le fichier assets/help_jjk.gif sur un service qui fournit une URL directe)
HELP_GIF_URL=

# Replis des images de Black Flash : en priorite, le bot envoie les fichiers locaux
# assets/blackflash_ok.png (succes) et assets/blackflash_ko.png (echec), qui
# n’expirent jamais. Ces URLs ne servent que si ces fichiers sont absents.
BLACKFLASH_OK_URL=
BLACKFLASH_KO_URL=

# Replis des images de la Renaissance en Esprit Vengeur : en priorite, le bot
# envoie les fichiers locaux assets/renaissance_ok.png (succes) et
# assets/renaissance_ko.png (echec), qui n’expirent jamais. Ces URLs ne servent
# que si ces fichiers sont absents.
RENAISSANCE_OK_URL=
RENAISSANCE_KO_URL=

# Facultatif : identifiant d’un rôle autorisé à utiliser les commandes du staff
STAFF_ROLE_ID=

# Dossier des données (fiches + images de personnage), par defaut data/ a cote du
# code. Sur un hebergeur qui remplace le dossier a chaque deploiement (clone Git),
# les fiches seraient EFFACEES a chaque mise a jour : pointe ce chemin vers un
# stockage persistant hors du depot clone, ex. /data/jjkbot
DATA_DIR=
